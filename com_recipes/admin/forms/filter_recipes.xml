<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_RECIPES_SEARCH_IN_TITLE"
			hint="JSEARCH_FILTER"
			/>

		<field
			name="published"
			type="status"
			label="JOPTION_SELECT_PUBLISHED"
			filter="integer"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

		<field
			name="difficulty"
			type="list"
			label="COM_RECIPES_FIELD_DIFFICULTY_LABEL"
			>
			<option value="">COM_RECIPES_FILTER_SELECT_DIFFICULTY</option>
			<option value="easy">COM_RECIPES_DIFFICULTY_EASY</option>
			<option value="medium">COM_RECIPES_DIFFICULTY_MEDIUM</option>
			<option value="hard">COM_RECIPES_DIFFICULTY_HARD</option>
		</field>
	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			default="a.title ASC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.published ASC">JSTATUS_ASC</option>
			<option value="a.published DESC">JSTATUS_DESC</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.prep_time ASC">COM_RECIPES_PREP_TIME_ASC</option>
			<option value="a.prep_time DESC">COM_RECIPES_PREP_TIME_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="20"
			/>
	</fields>
</form>
