<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_recipes</name>
	<author>Your Name</author>
	<creationDate>2026-09</creationDate>
	<copyright>(C) 2026 Your Name</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>1.0.0</version>
	<description>COM_RECIPES_XML_DESCRIPTION</description>
	<namespace path="src">Acme\Component\Recipes</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="site">
		<language tag="en-GB">language/en-GB/com_recipes.ini</language>
	</languages>

	<administration>
		<menu link="option=com_recipes" img="class:default">com_recipes</menu>
		<files folder="admin">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="admin">
			<language tag="en-GB">language/en-GB/com_recipes.ini</language>
			<language tag="en-GB">language/en-GB/com_recipes.sys.ini</language>
		</languages>
	</administration>
</extension>
